{
  "name": "staged",
  "version": "1.0.0",
  "private": true,
  "description": "A fun, friendly app for git that takes the place of the terminal: it sorts your changes into commits, names them, and runs your dev servers. Local, no AI needed.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "setup": "node server.mjs --install",
    "remove": "node server.mjs --uninstall",
    "plan": "node server.mjs plan",
    "release": "node release.mjs",
    "test": "node --test test/engine.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "staged": "server.mjs"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "files": [
    "server.mjs",
    "plan.mjs",
    "app-server.mjs",
    "tui.mjs",
    "commit.mjs",
    "feature-index.mjs",
    "updater.mjs",
    "writer.mjs",
    "insights.mjs",
    "run.mjs",
    "shrink.mjs",
    "public/",
    "README.md"
  ],
  "keywords": [
    "git",
    "commit",
    "gitmoji",
    "conventional-commits",
    "changelog",
    "dashboard"
  ]
}
