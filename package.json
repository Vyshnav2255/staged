{
  "name": "staged",
  "version": "0.2.0",
  "private": true,
  "description": "Every change across your git repos, sorted into features, commits and releases. Local, no AI needed.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "staged": "server.mjs"
  },
  "files": [
    "server.mjs",
    "commit.mjs",
    "insights.mjs",
    "public/",
    "README.md"
  ],
  "keywords": [
    "git",
    "commit",
    "gitmoji",
    "conventional-commits",
    "changelog",
    "dashboard"
  ]
}
